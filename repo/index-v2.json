: land within one frame of travel of dead centre and the block keeps its full size, and the placement scores double.\n* The slide speed ramps up as the tower grows, and consecutive frame perfects raise the chime pitch.\n\nStack Tower 3D is free and open-source software, licensed under the GNU General Public License v3.0. Built with libGDX.\n"}, "icon": {"en-US": {"name": "/stack.tower3d/en-US/icon_oSRaxd3LWJe78H4HcntAQoVuFVJgvPR_EOUqxxguaL0=.png", "sha256": "a1245ac5ddcb5897bbf07e07727b4042856e155260bcf47f10e52ac7182e68bd", "size": 516}}, "preferredSigner": "2fe09f50180d92e3b3204992ffc9a8c598087b9a7bac0b12d3f23a1e3687fd7f"}, "versions": {"ba5b0a48d74e33483d9dcb04e2e22ec745ee8e9266188bf9c59f2d2b2883c233": {"added": 1788627781000, "file": {"name": "/3DStackTower-v1.0.0.apk", "sha256": "ba5b0a48d74e33483d9dcb04e2e22ec745ee8e9266188bf9c59f2d2b2883c233", "size": 4461839}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.0.0", "versionCode": 1, "usesSdk": {"minSdkVersion": 21, "targetSdkVersion": 35}, "signer": {"sha256": ["2fe09f50180d92e3b3204992ffc9a8c598087b9a7bac0b12d3f23a1e3687fd7f"]}, "usesPermission": [{"name": "android.permission.VIBRATE"}, {"name": "stack.tower3d.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}}}